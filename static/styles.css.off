body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

header {
    background-color: #004080;
    color: white;
    padding: 10px 20px;
}

nav a {
    color: white;
    margin-right: 15px;
    text-decoration: none;
    font-weight: bold;
}

main {
    padding: 20px;
}

footer {
    background-color: #f0f0f0;
    text-align: center;
    padding: 10px;
    margin-top: 20px;
}

/* ------------------------------------------
   ADD ANNOUNCEMENT FORM
   ------------------------------------------ */

.announcement-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
}

.announcement-form input,
.announcement-form textarea {
    padding: 10px;
    font-size: 1rem;
    border-radius: 6px;
    border: 1px solid #ccc;
}

.announcement-form button {
    padding: 10px;
    font-size: 1rem;
    background-color: #004080;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

.announcement-form button:hover {
    background-color: #003060;
}

